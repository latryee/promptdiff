{
  "$defs": {
    "ComparisonResult": {
      "description": "Side-by-side comparison of two prompt version executions.",
      "properties": {
        "test_case": {
          "$ref": "#/$defs/TestCase"
        },
        "v1_result": {
          "$ref": "#/$defs/RunResult"
        },
        "v2_result": {
          "$ref": "#/$defs/RunResult"
        },
        "scores": {
          "additionalProperties": {
            "$ref": "#/$defs/EvaluatorScore"
          },
          "title": "Scores",
          "type": "object"
        },
        "text_diff": {
          "items": {
            "$ref": "#/$defs/DiffChunk"
          },
          "title": "Text Diff",
          "type": "array"
        },
        "json_diff": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Json Diff"
        },
        "is_json": {
          "default": false,
          "title": "Is Json",
          "type": "boolean"
        }
      },
      "required": [
        "test_case",
        "v1_result",
        "v2_result"
      ],
      "title": "ComparisonResult",
      "type": "object"
    },
    "DiffChunk": {
      "description": "A diff chunk between two output strings.",
      "properties": {
        "kind": {
          "enum": [
            "equal",
            "insert",
            "delete",
            "replace"
          ],
          "title": "Kind",
          "type": "string"
        },
        "v1_text": {
          "default": "",
          "title": "V1 Text",
          "type": "string"
        },
        "v2_text": {
          "default": "",
          "title": "V2 Text",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DiffChunk",
      "type": "object"
    },
    "ErrorCategory": {
      "description": "Normalized category of LLM execution or evaluation errors.",
      "enum": [
        "success",
        "timeout",
        "rate_limit",
        "authentication",
        "invalid_request",
        "provider_error",
        "evaluator_failure",
        "infrastructure"
      ],
      "title": "ErrorCategory",
      "type": "string"
    },
    "EvaluatorScore": {
      "description": "Result of an evaluation metric comparison.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "v1_score": {
          "title": "V1 Score"
        },
        "v2_score": {
          "title": "V2 Score"
        },
        "delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta"
        },
        "delta_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta Pct"
        },
        "passed": {
          "default": true,
          "title": "Passed",
          "type": "boolean"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "name",
        "v1_score",
        "v2_score"
      ],
      "title": "EvaluatorScore",
      "type": "object"
    },
    "RegressionVerdict": {
      "description": "Overall run status and list of failed assertions.",
      "properties": {
        "passed": {
          "default": true,
          "title": "Passed",
          "type": "boolean"
        },
        "status": {
          "default": "PASSED",
          "enum": [
            "PASSED",
            "REGRESSION_DETECTED",
            "ERROR"
          ],
          "title": "Status",
          "type": "string"
        },
        "failed_assertions": {
          "items": {
            "type": "string"
          },
          "title": "Failed Assertions",
          "type": "array"
        },
        "total_cost_v1": {
          "default": 0.0,
          "title": "Total Cost V1",
          "type": "number"
        },
        "total_cost_v2": {
          "default": 0.0,
          "title": "Total Cost V2",
          "type": "number"
        },
        "cost_delta_pct": {
          "default": 0.0,
          "title": "Cost Delta Pct",
          "type": "number"
        },
        "avg_latency_v1": {
          "default": 0.0,
          "title": "Avg Latency V1",
          "type": "number"
        },
        "avg_latency_v2": {
          "default": 0.0,
          "title": "Avg Latency V2",
          "type": "number"
        },
        "latency_delta_pct": {
          "default": 0.0,
          "title": "Latency Delta Pct",
          "type": "number"
        },
        "summary_metrics": {
          "additionalProperties": true,
          "title": "Summary Metrics",
          "type": "object"
        }
      },
      "title": "RegressionVerdict",
      "type": "object"
    },
    "RunProvenance": {
      "description": "Environment and system provenance metadata for reproducible evaluation runs.",
      "properties": {
        "framework_version": {
          "default": "3.5.0",
          "title": "Framework Version",
          "type": "string"
        },
        "runner_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runner Version"
        },
        "python_version": {
          "default": "",
          "title": "Python Version",
          "type": "string"
        },
        "platform": {
          "default": "",
          "title": "Platform",
          "type": "string"
        },
        "pricing_version": {
          "default": "2025.03",
          "title": "Pricing Version",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "git_branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Branch"
        },
        "git_dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Dirty"
        },
        "timestamp_utc": {
          "default": "",
          "title": "Timestamp Utc",
          "type": "string"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        }
      },
      "title": "RunProvenance",
      "type": "object"
    },
    "RunResult": {
      "description": "Output and performance telemetry from an LLM run.",
      "properties": {
        "prompt_name": {
          "title": "Prompt Name",
          "type": "string"
        },
        "test_case_id": {
          "title": "Test Case Id",
          "type": "string"
        },
        "rendered_prompt": {
          "title": "Rendered Prompt",
          "type": "string"
        },
        "output": {
          "title": "Output",
          "type": "string"
        },
        "latency_ms": {
          "title": "Latency Ms",
          "type": "number"
        },
        "prompt_tokens": {
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "completion_tokens": {
          "title": "Completion Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "title": "Total Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "title": "Cost Usd",
          "type": "number"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "cached": {
          "default": false,
          "title": "Cached",
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "error_category": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCategory"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "finish_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finish Reason"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "cost_status": {
          "default": "known",
          "enum": [
            "known",
            "estimated",
            "unavailable"
          ],
          "title": "Cost Status",
          "type": "string"
        },
        "raw_cost_details": {
          "additionalProperties": true,
          "title": "Raw Cost Details",
          "type": "object"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "number"
        }
      },
      "required": [
        "prompt_name",
        "test_case_id",
        "rendered_prompt",
        "output",
        "latency_ms",
        "prompt_tokens",
        "completion_tokens",
        "total_tokens",
        "cost_usd",
        "model"
      ],
      "title": "RunResult",
      "type": "object"
    },
    "TestCase": {
      "description": "Represents a single input scenario for prompt regression testing.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "vars": {
          "additionalProperties": true,
          "title": "Vars",
          "type": "object"
        },
        "expected_output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Output"
        },
        "schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "title": "TestCase",
      "type": "object"
    },
    "VarianceStats": {
      "description": "Statistical variance across repeated evaluation runs.",
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "samples": {
          "title": "Samples",
          "type": "integer"
        },
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "std_dev": {
          "title": "Std Dev",
          "type": "number"
        },
        "min_value": {
          "title": "Min Value",
          "type": "number"
        },
        "max_value": {
          "title": "Max Value",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "samples",
        "mean",
        "std_dev",
        "min_value",
        "max_value"
      ],
      "title": "VarianceStats",
      "type": "object"
    }
  },
  "description": "Complete serialized evaluation and regression report.",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "experiment_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Experiment Id"
    },
    "baseline_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Baseline Id"
    },
    "candidate_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Id"
    },
    "timestamp": {
      "default": "",
      "title": "Timestamp",
      "type": "string"
    },
    "v1_name": {
      "title": "V1 Name",
      "type": "string"
    },
    "v2_name": {
      "title": "V2 Name",
      "type": "string"
    },
    "model_v1": {
      "title": "Model V1",
      "type": "string"
    },
    "model_v2": {
      "title": "Model V2",
      "type": "string"
    },
    "v1_prompt_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "V1 Prompt Hash"
    },
    "v2_prompt_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "V2 Prompt Hash"
    },
    "dataset_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Hash"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "config_snapshot": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Config Snapshot"
    },
    "variance_stats": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/VarianceStats"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Variance Stats"
    },
    "comparisons": {
      "items": {
        "$ref": "#/$defs/ComparisonResult"
      },
      "title": "Comparisons",
      "type": "array"
    },
    "verdict": {
      "$ref": "#/$defs/RegressionVerdict"
    },
    "evaluators": {
      "items": {
        "type": "string"
      },
      "title": "Evaluators",
      "type": "array"
    },
    "total_cases": {
      "title": "Total Cases",
      "type": "integer"
    },
    "aggregate_stats": {
      "additionalProperties": true,
      "title": "Aggregate Stats",
      "type": "object"
    }
  },
  "required": [
    "v1_name",
    "v2_name",
    "model_v1",
    "model_v2",
    "comparisons",
    "verdict",
    "evaluators",
    "total_cases"
  ],
  "title": "DiffReport",
  "type": "object"
}