# ==============================================================================
# promptdiff Environment Variables
# ==============================================================================

# OpenAI API Key (or compatible endpoints like OpenRouter, DeepSeek, Groq)
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude API Key
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API Key
GEMINI_API_KEY=AIza...

# Ollama Host (Optional, default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Global default model (e.g. gpt-4o, claude-3-5-sonnet-latest, gemini-2.0-flash)
PROMPTDIFF_DEFAULT_MODEL=gpt-4o

# Cache settings (true/false)
PROMPTDIFF_CACHE=true
